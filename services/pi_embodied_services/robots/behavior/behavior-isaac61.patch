 log = create_module_logger(module_name=__name__)
 
 
+def _sdr_input(node, name):
+    """An Sdr shader node's input: GetShaderInput on OpenUSD without Ndr (Isaac Sim 6.1), GetInput before."""
+    get = getattr(node, "GetShaderInput", None) or node.GetInput
+    return get(name)
+
+
+def _sdr_input_names(node):
+    """An Sdr shader node's input names (GetShaderInputNames on Isaac Sim 6.1, GetInputNames before)."""
+    get = getattr(node, "GetShaderInputNames", None) or node.GetInputNames
+    return get()
+
+
 class MaterialPrim(BasePrim):
     """
     Provides high level functions to deal with a material prim and its attributes/ properties.
@@ -272,7 +284,7 @@ class MaterialPrim(BasePrim):
         if non_default_inp is not None:
             return non_default_inp
 
-        return self._shader_node.GetInput(inp).GetDefaultValue()
+        return _sdr_input(self._shader_node, inp).GetDefaultValue()
 
     def set_input(self, inp, val):
         """
@@ -314,7 +326,7 @@ class MaterialPrim(BasePrim):
         Returns:
             set: All the shader input names associated with this material that have default values
         """
-        return set(self._shader_node.GetInputNames())
+        return set(_sdr_input_names(self._shader_node))
 
     def get_shader_input_names_by_type(self, input_type, include_default=False):
         """
@@ -332,7 +344,7 @@ class MaterialPrim(BasePrim):
         shader_default_input_names = {
             inp_name
             for inp_name in self.shader_default_input_names
-            if self._shader_node.GetInput(inp_name).GetType() == input_type
+            if _sdr_input(self._shader_node, inp_name).GetType() == input_type
         }
         return shader_input_names | shader_default_input_names
 
