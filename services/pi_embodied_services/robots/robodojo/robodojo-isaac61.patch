+def use_torch_backend():
+    """isaacsim.core prims pick their tensor backend when constructed. Isaac Lab 2's SimulationContext
+    (an isaacsim.core SimulationContext) set it to torch; Isaac Lab 3's does not, so it is set here,
+    before any scene object exists."""
+    from isaacsim.core.simulation_manager import SimulationManager
+
+    SimulationManager.set_backend("torch")
+
+
+def physics_sim_view():
+    """The PhysX tensor simulation view (torch frontend) the isaacsim.core prims initialize against.
+
+    Isaac Sim 5 keeps it in isaacsim.core's SimulationManager. Under Isaac Lab 3 (Isaac Sim 6) the
+    SimulationManager creates none and Isaac Lab's own view has the warp frontend, so a torch view is
+    created on the current stage (again after a stage reload) and registered with SimulationManager,
+    whose deprecated prims read it from there. None before the simulation plays.
+    """
+    import omni.physx
+    import omni.usd
+    from isaacsim.core.simulation_manager import SimulationManager
+
+    # Prims added while the simulation runs (RoboDojo spawns each layout's objects then) reach PhysX
+    # only on its next update; flush them so a view created now sees them.
+    omni.physx.get_physx_simulation_interface().flush_changes()
+    view = SimulationManager.get_physics_sim_view()
+
+    stage_id = omni.usd.get_context().get_stage_id()
+    if view is not None and (_VIEW["view"] is not view or _VIEW["stage_id"] == stage_id):
+        return view
+    import omni.physics.tensors
+
+    # Before the simulation plays there is no physics scene to view (Isaac Sim 5 returned None too).
+    if not omni.physx.get_physx_interface().is_running():
+        return None
+    try:
+        view = omni.physics.tensors.create_simulation_view("torch", stage_id=stage_id)
+    except Exception:
+        return None
+    if view is None:
+        return None
+    view.set_subspace_roots("/")
+    SimulationManager._physics_sim_view = view
+    SimulationManager.set_backend("torch")
+    _VIEW.update(stage_id=stage_id, view=view)
+    return view
+
+
+def forget_view():
+    """Drop the torch view when the simulation closes: the next stage gets a fresh one."""
+    from isaacsim.core.simulation_manager import SimulationManager
+
+    view = _VIEW["view"]
+    if view is not None and SimulationManager._physics_sim_view is view:
+        try:
+            view.invalidate()
+        except Exception:
+            pass
+        SimulationManager._physics_sim_view = None
+    _VIEW.update(stage_id=None, view=None)
